# Copy to .env and fill in what you have. Nothing here is required for `npm run demo`.

# --- Ring -------------------------------------------------------------------
# Live mode with the Ring Developer Playground (no device, no app registration):
#   https://developer.amazon.com/ring/console/playground -> Generate Token
# The token lasts about 30 minutes. With it set, `npm start` runs against the real API.
RING_ACCESS_TOKEN=

# Production-style auth instead (from your registered Ring app + account linking):
# RING_CLIENT_ID=
# RING_CLIENT_SECRET=
# RING_REFRESH_TOKEN=
# HMAC signing key for verifying webhooks (also from app registration):
# RING_HMAC_KEY=

# --- Amazon Bedrock (vision check, evening note, "Ask Porchlight") ------------
# Easiest: a Bedrock API key (Bedrock console -> API keys).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Or standard AWS credentials / AWS_PROFILE.
# Models (defaults shown); any Bedrock model with Converse + image input works for vision.
# PORCHLIGHT_TEXT_MODEL=us.amazon.nova-pro-v1:0
# PORCHLIGHT_VISION_MODEL=us.amazon.nova-lite-v1:0

# --- Household (live mode) -----------------------------------------------------
# PORCHLIGHT_RESIDENT_NAME=Rose
# PORCHLIGHT_TIMEZONE=America/New_York
# PORCHLIGHT_CAREGIVER_NAME=Maria
# PORCHLIGHT_CHECK_IN_BY=09:30

# --- Optional ------------------------------------------------------------------
# Real phone push for family alerts via ntfy.sh (pick a long random topic name):
# PORCHLIGHT_NTFY_TOPIC=
# Require a bearer token on the Alexa+ MCP endpoint:
# PORCHLIGHT_MCP_TOKEN=
# PORT=4000
